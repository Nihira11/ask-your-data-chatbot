# Copy to .env locally. Never commit real credentials.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Create the database and restricted role separately.
DATABASE_URL=postgresql+psycopg://readonly_user:change_me@localhost:5432/ask_your_data

# Proposed limits; wire these into the backend before enabling it.
MAX_QUERY_RETRIES=2
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=10
FAISS_INDEX_PATH=data/indexes
